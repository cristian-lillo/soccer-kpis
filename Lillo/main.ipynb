   "source": [
    "# kloppy"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "85c21bb4",
   "metadata": {},
   "source": [
    "## Import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "66e79cba",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "from kloppy import statsbomb\n",
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e3c58417",
   "metadata": {},
   "source": [
    "## Define constants"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a18b6149",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Project folder\n",
    "PROJECT_FOLDER = Path(\"..\")\n",
    "\n",
    "# Base data folder\n",
    "DATA_FOLDER = PROJECT_FOLDER / \"data\"\n",
    "\n",
    "# Chile data folder\n",
    "CHILE_DATA_FOLDER = DATA_FOLDER / \"chile\"\n",
    "\n",
    "# StatsBomb data folders\n",
    "STATSBOMB_DATA_FOLDER = DATA_FOLDER / \"statsbomb\"\n",
    "STATSBOMB_EVENTS_DATA_FOLDER = STATSBOMB_DATA_FOLDER / \"events\"\n",
    "STATSBOMB_LINEUPS_DATA_FOLDER = STATSBOMB_DATA_FOLDER / \"lineups\"\n",
    "\n",
    "# Wyscout data folders\n",
    "WYSCOUT_DATA_FOLDER = DATA_FOLDER / \"wyscout\"\n",
    "WYSCOUT_PROCESSED_DATA_FOLDER = WYSCOUT_DATA_FOLDER / \"processed\" / \"files\"\n",
    "WYSCOUT_PROCESSED_V2_FOLDER = WYSCOUT_DATA_FOLDER / \"processed-v2\" / \"files\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "66d8015d",
   "metadata": {},
   "source": [
    "## Load Statsbomb data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d0255d57",
   "metadata": {},
   "outputs": [],
   "source": [
    "statsbomb_match_path = STATSBOMB_EVENTS_DATA_FOLDER / \"3943043.json\"\n",
    "statsbomb_lineup_path = STATSBOMB_LINEUPS_DATA_FOLDER / \"3943043.json\"\n",
    "\n",
    "statsbomb_dataset = statsbomb.load(\n",
    "    event_data=statsbomb_match_path,\n",
    "    lineup_data=statsbomb_lineup_path,\n",
    ")"
   ]
  },
