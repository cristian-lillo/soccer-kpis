  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# EA Sports Player Performance Index\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "from kloppy import statsbomb, wyscout"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add the project root to the Python path\n",
    "sys.path.append(str(Path.cwd().parents[1]))\n",
    "from config import project_paths"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ignore future warnings\n",
    "warnings.filterwarnings(\"ignore\", category=FutureWarning)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Constants"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "# COEFFICIENTS FOR THE INDEX\n",
    "\n",
    "## Subindex 1: Model coefficients\n",
    "MODEL_COEFFICIENTS = {\n",
    "    \"crosses\": 0.519,\n",
    "    \"dribbles\": 0.118,\n",
    "    \"passes\": 0.034,\n",
    "    \"opp_interceptions\": -0.024,\n",
    "    \"opp_yellows\": 0.253,\n",
    "    \"opp_reds\": 1.023,\n",
    "    \"opp_tackle_win_ratio\": -0.170,\n",
    "    \"opp_clearances\": -0.017,\n",
    "    \"constant\": 6.463,\n",
    "}\n",
    "\n",
    "## Subindex 2\n",
    "POINTS_FOR_WIN = 3\n",
    "POINTS_FOR_DRAW = 1\n",
    "POINTS_FOR_LOSS = 0\n",
    "\n",
    "## Subindex 3\n",
    "POINTS_PER_GAME = 1.34\n",
    "\n",
    "## Subindex 4\n",
    "POINTS_PER_GOAL = 1.039\n",
    "\n",
    "## Subindex 5\n",
    "POINTS_PER_ASSIST = 1.039\n",
    "\n",
    "## Subindex 6\n",
    "POINTS_PER_CLEAN_SHEET_GOALKEEPER = 0.585\n",
    "POINTS_PER_CLEAN_SHEET_DEFENDER = 0.364\n",
    "POINTS_PER_CLEAN_SHEET_MIDFIELDER = 0.150\n",
    "POINTS_PER_CLEAN_SHEET_STRIKER = 0.071"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Necessary variables for the index with dummy values\n",
    "position = \"ST\"\n",
    "minutes_played = 90\n",
    "goals = 2\n",
    "assists = 1\n",
    "\n",
    "home_goals = 4\n",
    "away_goals = 2\n",
    "\n",
    "team_minutes = 990\n",
    "clean_sheets = 0\n",
    "\n",
    "stats = {\n",
    "    \"crosses\": 3,\n",
    "    \"dribbles\": 1,\n",
    "    \"passes\": 20,\n",
    "    \"opp_interceptions\": 3,\n",
    "    \"opp_yellows\": 1,\n",
    "    \"opp_reds\": 0,\n",
    "    \"opp_tackle_win_ratio\": 0.2,\n",
    "    \"opp_clearances\": 1,\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load providers data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "# StatsBomb match and player IDs for testing (UEFA Euro 2024 Final - Lamine Yamal)\n",
    "match_id = 3943043\n",
    "player_id = 316046\n",
    "provider = \"statsbomb\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load dataset based on provider\n",
    "if provider == \"statsbomb\":\n",
    "    dataset = statsbomb.load(\n",
    "        event_data=project_paths.STATSBOMB_EVENTS_DIR / f\"{match_id}.json\",\n",
    "        lineup_data=project_paths.STATSBOMB_LINEUPS_DIR / f\"{match_id}.json\",\n",
    "    )\n",
    "elif provider == \"wyscout\":\n",
    "    dataset = wyscout.load(\n",
    "        event_data=project_paths.WYSCOUT_PROCESSED_V2_DIR / f\"{match_id}.json\",\n",
    "    )\n",
    "else:\n",
    "    raise ValueError(\"Unsupported provider. Use 'statsbomb' or 'wyscout'.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert dataset to DataFrame for easier exploration\n",
    "df = dataset.to_df()"
   ]
