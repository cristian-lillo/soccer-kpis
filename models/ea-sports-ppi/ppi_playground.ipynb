   "source": [
    "# Create expanded event features with result and success combinations\n",
    "def create_event_features(df):\n",
    "    \"\"\"Create expanded event features combining event_type with result and success\"\"\"\n",
    "\n",
    "    # Copy DataFrame to avoid modifying original\n",
    "    expanded_df = df.copy()\n",
    "\n",
    "    # Create event_result combinations (e.g., \"pass_complete\", \"shot_goal\")\n",
    "    expanded_df[\"event_result\"] = expanded_df[\"event_type\"].astype(str) + \"_\" + expanded_df[\"result\"].astype(str)\n",
    "\n",
    "    # Create event_success combinations (e.g., \"pass_successful\", \"duel_unsuccessful\")\n",
    "    expanded_df[\"event_success\"] = (\n",
    "        expanded_df[\"event_type\"].astype(str)\n",
    "        + \"_\"\n",
    "        + expanded_df[\"success\"].astype(str).replace({\"True\": \"successful\", \"False\": \"unsuccessful\", \"<NA>\": \"unknown\"})\n",
    "    )\n",
    "\n",
    "    # Clean up nan/None values\n",
    "    # expanded_df[\"event_result\"] = expanded_df[\"event_result\"].str.replace(\"_nan\", \"\")\n",
    "    # expanded_df[\"event_success\"] = expanded_df[\"event_success\"].str.replace(\"_unknown\", \"\")\n",
    "\n",
    "    return expanded_df\n",
    "\n",
    "\n",
    "# Apply the expansion\n",
    "expanded_player_events_df = create_event_features(player_events_df)\n",
    "\n",
    "# Check the new columns\n",
    "print(f\"### EVENT_TYPE ###\\n{expanded_player_events_df['event_type'].value_counts().sort_index()}\\n\")\n",
    "print(f\"### EVENT_RESULT ###\\n{expanded_player_events_df['event_result'].value_counts().sort_index()}\\n\")\n",
    "print(f\"### EVENT_SUCCESS ###\\n{expanded_player_events_df['event_success'].value_counts().sort_index()}\")"
   ]
  },
