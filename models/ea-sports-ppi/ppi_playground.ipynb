    "index_1 = MODEL_COEFFICIENTS[\"constant\"]\n",
    "for action, coeff in MODEL_COEFFICIENTS.items():\n",
    "    if action != \"constant\":\n",
    "        count = stats.get(action, 0)\n",
    "        index_1 += coeff * count"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Subindex 2: Points-Sharing Index\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "if home_goals > away_goals:\n",
    "    index_2 = (minutes_played / team_minutes) * POINTS_FOR_WIN\n",
    "elif home_goals == away_goals:\n",
    "    index_2 = (minutes_played / team_minutes) * POINTS_FOR_DRAW\n",
    "else:  # home_goals < away_goals\n",
    "    index_2 = (minutes_played / team_minutes) * POINTS_FOR_LOSS"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Subindex 3: Appearance Index\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "index_3 = (minutes_played / team_minutes) * POINTS_PER_GAME"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Subindex 4: Goal-Scoring Index\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "index_4 = goals * POINTS_PER_GOAL"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Subindex 5: Assists Index\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "index_5 = assists * POINTS_PER_ASSIST"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Subindex 6: Clean-Sheets Index\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "if clean_sheets:\n",
    "    if position == \"goalkeeper\":\n",
    "        index_6 = POINTS_PER_CLEAN_SHEET_GOALKEEPER\n",
    "    elif position == \"defender\":\n",
    "        index_6 = POINTS_PER_CLEAN_SHEET_DEFENDER\n",
    "    elif position == \"midfielder\":\n",
    "        index_6 = POINTS_PER_CLEAN_SHEET_MIDFIELDER\n",
    "    elif position == \"striker\":\n",
    "        index_6 = POINTS_PER_CLEAN_SHEET_STRIKER\n",
    "else:\n",
    "    index_6 = 0"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Final Index\n"
   ]
  },
