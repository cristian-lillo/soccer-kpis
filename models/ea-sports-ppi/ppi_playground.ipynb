   "source": [
    "# Merge all event types into comprehensive player stats\n",
    "def merge_all_event_stats(base_df, result_df, success_df, team_mapping_df):\n",
    "    \"\"\"Merge base events, event+result, event+success and team info into one DataFrame\"\"\"\n",
    "\n",
    "    # Start with base events\n",
    "    merged_df = base_df.copy()\n",
    "\n",
    "    # Add team information (1:1 mapping)\n",
    "    merged_df = merged_df.merge(team_mapping_df, on=\"player\", how=\"left\")\n",
    "\n",
    "    # Reorder columns to put team right after player\n",
    "    base_event_cols = [col for col in merged_df.columns if col not in [\"player\", \"team\"]]\n",
    "    merged_df = merged_df[[\"player\", \"team\"] + base_event_cols]\n",
    "\n",
    "    # Merge event+result stats\n",
    "    if not result_df.empty:\n",
    "        merged_df = merged_df.merge(result_df, on=\"player\", how=\"left\")\n",
    "\n",
    "    # Merge event+success stats\n",
    "    if not success_df.empty:\n",
    "        merged_df = merged_df.merge(success_df, on=\"player\", how=\"left\")\n",
    "\n",
    "    # Fill NaN values with 0 (players who didn't perform certain actions)\n",
    "    merged_df = merged_df.fillna(0)\n",
    "\n",
    "    return merged_df\n",
    "\n",
    "\n",
    "# Create comprehensive player stats\n",
    "comprehensive_player_stats = merge_all_event_stats(\n",
    "    event_count_by_player_df, event_result_count_df, event_success_count_df, player_team_mapping\n",
    ")\n",
    "\n",
    "print(\"Comprehensive player stats:\")\n",
    "print(f\"Shape: {comprehensive_player_stats.shape} (players x features)\")\n",
    "print(f\"Columns: {list(comprehensive_player_stats.columns)}\")\n",
    "print(\"\\nFirst 3 players:\")\n",
    "comprehensive_player_stats.head(3)"
   ]
  },
